# Copy to .env (never commit .env).
# Supabase > Project Settings > Database > Connection string (URI).
# The session pooler (port 5432) or a direct connection both work.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Any long random string, used to sign the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# API port and the URL of the React app (used in emailed links).
PORT=4000
APP_URL=http://localhost:5173

# Where uploaded files are stored (outside any public directory).
# Relative paths resolve from the server/ folder.
UPLOAD_DIR=./uploads

# --- SEC-01 brute-force protection (optional; defaults shown) ---------------
# Lock an account after LOGIN_MAX_ATTEMPTS failed logins within
# LOGIN_WINDOW_MINUTES, for LOGIN_LOCKOUT_MINUTES. Shorten only for testing.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MINUTES=15
# LOGIN_LOCKOUT_MINUTES=15
# Max requests per minute per IP to login / register / forgot-password.
# AUTH_RATE_LIMIT_PER_MINUTE=10
# Only set when running behind a real reverse proxy that sets X-Forwarded-For
# (e.g. TRUST_PROXY=1). Leave unset locally so clients can't spoof their IP.
# TRUST_PROXY=

# --- SEC-05 session hardening (optional; defaults shown) --------------------
# A session is refused after SESSION_IDLE_TIMEOUT_MINUTES without any request,
# and SESSION_ABSOLUTE_TIMEOUT_MINUTES after login even if active (480 = 8 h).
# Shorten for testing (e.g. idle 1) or lengthen for automated scans.
# SESSION_IDLE_TIMEOUT_MINUTES=15
# SESSION_ABSOLUTE_TIMEOUT_MINUTES=480
# NODE_ENV=production also adds the Secure flag to the session cookie (HTTPS only).

# --- SEC-11 health data encryption (REQUIRED for v1) -----------------------
# 32 random bytes, base64 (44 chars) or hex (64 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Everyone sharing the same database must use the SAME key, or the seeded
# health data can't be decrypted. Never commit the real key.
HEALTH_DATA_KEY=replace-with-32-random-bytes-in-base64
# Label stored with each encrypted value (change it when rotating keys).
# HEALTH_DATA_KEY_ID=k1
# Old keys still needed to decrypt during a rotation, e.g. k1=<old key>
# HEALTH_DATA_OLD_KEYS=
